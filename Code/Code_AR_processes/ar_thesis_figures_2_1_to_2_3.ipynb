    "# Fixed settings make the displayed process and optimization reproducible.\n",
    "single_ar1_seed = 20260813\n",
    "single_ar1_replication = 0\n",
    "single_ar1_T = 2_000\n",
    "single_ar1_burnin = 1_000\n",
    "single_ar1_k_values = np.arange(1, 11)\n",
    "single_ar1_generator = np.random.default_rng(np.random.SeedSequence([\n",
    "    single_ar1_seed, single_ar1_replication, 0\n",
    "]))\n",
    "single_ar1_phi = jones_ar_coefficients(\n",
    "    1, rng=single_ar1_generator\n",
    ")\n",
    "single_ar1_series = simulate_uniform_ar(\n",
    "    single_ar1_phi, single_ar1_T, single_ar1_burnin, 1.0,\n",
    "    rng=single_ar1_generator,\n",
    ")\n",
    "_, single_ar1_widths, _, single_ar1_empirical_directions = (\n",
    "    batched_geometric_width_curves(\n",
    "    single_ar1_series,\n",
    "    single_ar1_k_values,\n",
    "    seed=single_ar1_seed,\n",
    "    replication=single_ar1_replication,\n",
    "    starts=3,\n",
    "    iterations=500,\n",
    "    initial_step=0.2,\n",
    "    geometric_decay=0.99,\n",
    "    return_directions=True,\n",
    "    )\n",
    ")\n",
    "single_ar1_selection = horizontal_tail_lad_selector(\n",
    "    single_ar1_k_values, single_ar1_widths\n",
    ")\n",
    "single_ar1_q_hat = single_ar1_selection[\"selected_q\"]\n",
    "single_ar1_p_hat = single_ar1_selection[\"selected_order\"]\n",
    "single_ar1_population_width = 2.0 / np.sqrt(\n",
    "    1.0 + single_ar1_phi[0] ** 2\n",
    ")\n",
    "single_ar1_population_directions = []\n",
    "single_ar1_empirical_at_population_min = []\n",
    "single_ar1_population_at_empirical_min = []\n",
    "for k, empirical_direction in zip(\n",
    "    single_ar1_k_values, single_ar1_empirical_directions\n",
    "):\n",
    "    if k == 1:\n",
    "        population_direction = np.ones(1)\n",
    "    else:\n",
    "        population_direction = np.r_[\n",
    "            1.0, -single_ar1_phi[0], np.zeros(k - 2)\n",
    "        ]\n",
    "        population_direction /= np.linalg.norm(population_direction)\n",
    "    cloud_k = sliding_window_point_cloud(single_ar1_series, int(k))\n",
    "    population_direction_projections = cloud_k @ population_direction\n",
    "    single_ar1_population_directions.append(population_direction)\n",
    "    single_ar1_empirical_at_population_min.append(\n",
    "        np.ptp(population_direction_projections)\n",
    "    )\n",
    "    single_ar1_population_at_empirical_min.append(\n",
    "        theoretical_ar_width_in_direction(\n",
    "            single_ar1_phi, empirical_direction, half_width=1.0\n",
    "        )\n",
    "    )\n",
    "single_ar1_empirical_at_population_min = np.asarray(\n",
    "    single_ar1_empirical_at_population_min\n",
    ")\n",
    "single_ar1_population_at_empirical_min = np.asarray(\n",
    "    single_ar1_population_at_empirical_min\n",
    ")\n",
    "\n",
    "single_ar1_pipeline_results = pd.DataFrame({                                                        ### REPORTING\n",
    "    \"k\": single_ar1_k_values,                                                                       ### REPORTING\n",
    "    \"empirical_width\": single_ar1_widths,                                                           ### REPORTING\n",
    "    \"population_width\": np.where(                                                                   ### REPORTING\n",
    "        single_ar1_k_values >= 2, single_ar1_population_width, np.nan                               ### REPORTING\n",
    "    ),                                                                                              ### REPORTING\n",
    "    \"empirical_at_population_min\": (                                                                ### REPORTING\n",
    "        single_ar1_empirical_at_population_min                                                      ### REPORTING\n",
    "    ),                                                                                              ### REPORTING\n",
    "    \"population_at_empirical_min\": (                                                                ### REPORTING\n",
    "        single_ar1_population_at_empirical_min                                                      ### REPORTING\n",
    "    ),                                                                                              ### REPORTING\n",
    "    \"selected_LAD_fit\": single_ar1_selection[\"fitted_values\"],                                      ### REPORTING\n",
    "})                                                                                                  ### REPORTING\n",
    "\n",
    "fig, axis = plt.subplots(figsize=(10.5, 6.4), constrained_layout=True)                              ### PLOTTING\n",
    "axis.plot(                                                                                          ### PLOTTING\n",
    "    single_ar1_k_values, single_ar1_widths, color=\"#1764ab\",                                        ### PLOTTING\n",
    "    marker=\"o\", markersize=7.5, linewidth=2.3, zorder=4,                                            ### PLOTTING\n",
    "    label=r\"empirical $\\widehat m_k$\",                                                              ### PLOTTING\n",
    ")                                                                                                   ### PLOTTING\n",
    "axis.plot(                                                                                          ### PLOTTING\n",
    "    single_ar1_k_values[1:],                                                                        ### PLOTTING\n",
    "    np.full(len(single_ar1_k_values) - 1, single_ar1_population_width),                             ### PLOTTING\n",
    "    color=\"black\", linestyle=\"--\", linewidth=2.5, zorder=2,                                         ### PLOTTING\n",
    "    label=r\"population $m_k=m^*$ for $k\\geq2$\",                                                     ### PLOTTING\n",
    ")                                                                                                   ### PLOTTING\n",
    "axis.plot(                                                                                          ### PLOTTING\n",
    "    single_ar1_k_values, single_ar1_population_at_empirical_min,                                    ### PLOTTING\n",
    "    color=\"#e66101\", marker=\"s\", markersize=5.8,                                                    ### PLOTTING\n",
    "    linestyle=\"--\", linewidth=2.0, zorder=3,                                                        ### PLOTTING\n",
    "    label=r\"population at empirical minimizer $w_k(\\widehat u_k)$\",                                 ### PLOTTING\n",
    ")                                                                                                   ### PLOTTING\n",
    "\n",
    "axis.axvline(                                                                                       ### PLOTTING\n",
    "    single_ar1_q_hat, color=\"#c51b2b\", linestyle=\"-.\",                                              ### PLOTTING\n",
    "    linewidth=1.7, zorder=1,                                                                        ### PLOTTING\n",
    "    label=rf\"selected $\\widehat q={single_ar1_q_hat}$ ($\\widehat p={single_ar1_p_hat}$)\",           ### PLOTTING\n",
    ")                                                                                                   ### PLOTTING\n",
    "axis.scatter(                                                                                       ### PLOTTING\n",
    "    [single_ar1_q_hat], [single_ar1_selection[\"level\"]],                                            ### PLOTTING\n",
    "    marker=\"o\", s=150, color=\"#c51b2b\", edgecolor=\"none\",                                           ### PLOTTING\n",
    "    zorder=7,                                                                                       ### PLOTTING\n",
    ")                                                                                                   ### PLOTTING\n",
    "axis.text(                                                                                          ### PLOTTING\n",
    "    0.975, 0.965,                                                                                   ### PLOTTING\n",
    "    rf\"$\\phi_1={single_ar1_phi[0]:.3f}$\" + \"\\n\"                                                     ### PLOTTING\n",
    "    + rf\"$T={single_ar1_T:,}$, $K={single_ar1_k_values[-1]}$\" + \"\\n\"                                ### PLOTTING\n",
    "    + rf\"$\\widehat q={single_ar1_q_hat}$, $\\widehat p={single_ar1_p_hat}$\",                         ### PLOTTING\n",
    "    transform=axis.transAxes, ha=\"right\", va=\"top\", fontsize=11,                                    ### PLOTTING\n",
    "    bbox={\"boxstyle\": \"round,pad=0.45\", \"facecolor\": \"white\",                                       ### PLOTTING\n",
    "          \"edgecolor\": \"0.75\", \"alpha\": 0.94},                                                      ### PLOTTING\n",
    ")                                                                                                   ### PLOTTING\n",
    "axis.set(                                                                                           ### PLOTTING\n",
    "    title=\"One AR(1) process: population and empirical widths with selected elbow\",                 ### PLOTTING\n",
    "    xlabel=r\"embedding dimension $k$\",                                                              ### PLOTTING\n",
    "    ylabel=r\"directional width\",                                                                    ### PLOTTING\n",
    "    xticks=single_ar1_k_values,                                                                     ### PLOTTING\n",
    ")                                                                                                   ### PLOTTING\n",
    "axis.grid(axis=\"y\", color=\"0.88\", linewidth=0.8)                                                    ### PLOTTING\n",
    "axis.spines[[\"top\", \"right\"]].set_visible(False)                                                    ### PLOTTING\n",
    "for extension in (\"pdf\", \"png\"):                                                                    ### PLOTTING\n",
    "    fig.savefig(                                                                                    ### PLOTTING\n",
    "        FIGURE_OUTPUT_DIR / f\"AR1_experiment.{extension}\",                                          ### PLOTTING\n",
    "        dpi=220, bbox_inches=\"tight\",                                                               ### PLOTTING\n",
    "    )                                                                                               ### PLOTTING\n",
    "plt.show()                                                                                          ### PLOTTING\n",
    "\n",
    "print(f\"AR coefficient phi_1 = {single_ar1_phi[0]:.6f}\")                                            ### REPORTING\n",
    "print(f\"Population plateau m* = {single_ar1_population_width:.6f}\")                                 ### REPORTING\n",
    "print(                                                                                              ### REPORTING\n",
    "    f\"Selected q = {single_ar1_q_hat}; \"                                                            ### REPORTING\n",
    "    f\"selected AR order p = {single_ar1_p_hat}; \"                                                   ### REPORTING\n",
    "    f\"LAD score = {single_ar1_selection['score']:.6f}\"                                              ### REPORTING\n",
    ")                                                                                                   ### REPORTING\n",
    "print(single_ar1_pipeline_results.to_string(index=False))                                           ### REPORTING\n"
   ]
