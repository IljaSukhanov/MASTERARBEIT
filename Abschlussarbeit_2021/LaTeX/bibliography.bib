@article{chacon_existence_nodate,
    title = {{ON} {THE} {EXISTENCE} {AND} {LIMIT} {BEHAVIOR} {OF} {THE} {OPTIMAL} {BANDWIDTH} {FOR} {KERNEL} {DENSITY} {ESTIMATION}},
    abstract = {We prove, under mild conditions, the existence of a minimizer of the exact mean integrated square error of a kernel density estimator as a function of the bandwidth. When it exists, we also show some expected limit properties of this optimal bandwidth; in fact, for two common situations, Theorem 3 gives the exact value for the limit. Surprisingly, in some special cases (when using superkernels or the sinc kernel for estimating some classes of densities), this limit is strictly positive and a global zero-bias bandwidth can be chosen.},
    language = {en},
    author = {Chacon, J E and Montanero, J and Nogales, A G and Perez, P},
}