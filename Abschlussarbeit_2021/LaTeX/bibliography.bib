@article{chan_approximating_nodate,
  title = {Approximating the {Diameter}, {Width}, {Smallest} {Enclosing} {Cylinder}, and {Minimum}-{Width} {Annulus}},
  abstract = {We study (1 + e)-factor approximation algorithms for several well-known optimization problems on a given npoint set: (a) diameter, (b) width, (c) smallest enclosing cylinder, and (d) minimum-width annulus. Among our results are new simple algorithms for (a) and (c) with an improved dependence of the running time on e, as well as the first linear-time approximation algorithm for (d) in any fixed dimension. All four problems can be solved within a time bound of the form O(n + e-c) or O(n log(1/e) + {\textasciitilde}-{\textasciitilde}).},
  language = {en},
  author = {Chan, Timothy M},
}

