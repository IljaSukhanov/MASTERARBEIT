@INPROCEEDINGS{Shi2008-wy,
  title           = "Data spectroscopy",
  booktitle       = "Proceedings of the 25th international conference on
                     Machine learning - {ICML} '08",
  author          = "Shi, Tao and Belkin, Mikhail and Yu, Bin",
  abstract        = "In this paper we develop a spectral framework for
                     estimating mixture distributions, specifically Gaussian
                     mixture models. In physics, spectroscopy is often used for
                     the identification of substances through their spectrum.
                     Treating a kernel function K(x, y) as ``light'' and the
                     sampled data as ``substance'', the spectrum of their
                     interaction (eigenvalues and eigenvectors of the kernel
                     matrix K) unveils certain aspects of the underlying
                     parametric distribution p, such as the parameters of a
                     Gaussian mixture. Our approach extends the intuitions and
                     analyses underlying the existing spectral techniques, such
                     as spectral clustering and Kernel Principal Components
                     Analysis (KPCA).",
  publisher       = "ACM Press",
  year            =  2008,
  address         = "New York, New York, USA",
  conference      = "the 25th international conference",
  location        = "Helsinki, Finland"
}

