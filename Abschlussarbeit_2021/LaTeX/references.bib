}

@misc{hunt_simplicial_2012,
	title = {Simplicial Nonlinear Principal Component Analysis},
	url = {http://arxiv.org/abs/1207.3374},
	doi = {10.48550/arXiv.1207.3374},
	abstract = {We present a new manifold learning algorithm that takes a set of data points lying on or near a lower dimensional manifold as input, possibly with noise, and outputs a simplicial complex that ﬁts the data and the manifold. We have implemented the algorithm in the case where the input data has arbitrary dimension, but can be triangulated. We provide triangulations of data sets that fall on the surface of a torus, sphere, swiss roll, and creased sheet embedded in R50. We also discuss the theoretical justiﬁcation of our algorithm.},
