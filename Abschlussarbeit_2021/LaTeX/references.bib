}

@article{bobrowski_topology_2015,
	title = {The topology of probability distributions on manifolds},
	volume = {161},
	issn = {1432-2064},
	url = {https://doi.org/10.1007/s00440-014-0556-x},
	doi = {10.1007/s00440-014-0556-x},
	abstract = {Let \$\${\textbackslash}mathcal \{P\}\$\$be a set of \$\$n\$\$random points in \$\${\textbackslash}mathbb \{R\}{\textasciicircum}d\$\$, generated from a probability measure on a \$\$m\$\$-dimensional manifold \$\${\textbackslash}mathcal \{M\}{\textbackslash}subset {\textbackslash}mathbb \{R\}{\textasciicircum}d\$\$. In this paper we study the homology of \$\${\textbackslash}mathcal \{U\}({\textbackslash}mathcal \{P\},r)\$\$—the union of \$\$d\$\$-dimensional balls of radius \$\$r\$\$around \$\${\textbackslash}mathcal \{P\}\$\$, as \$\$n{\textbackslash}rightarrow {\textbackslash}infty \$\$, and \$\$r{\textbackslash}rightarrow 0\$\$. In addition we study the critical points of \$\$d\_\{{\textbackslash}mathcal \{P\}\}\$\$—the distance function from the set \$\${\textbackslash}mathcal \{P\}\$\$. These two objects are known to be related via Morse theory. We present limit theorems for the Betti numbers of \$\${\textbackslash}mathcal \{U\}({\textbackslash}mathcal \{P\},r)\$\$, as well as for number of critical points of index \$\$k\$\$for \$\$d\_\{{\textbackslash}mathcal \{P\}\}\$\$. Depending on how fast \$\$r\$\$decays to zero as \$\$n\$\$grows, these two objects exhibit different types of limiting behavior. In one particular case (\$\$n r{\textasciicircum}m {\textbackslash}ge C {\textbackslash}log n\$\$), we show that the Betti numbers of \$\${\textbackslash}mathcal \{U\}({\textbackslash}mathcal \{P\},r)\$\$perfectly recover the Betti numbers of the original manifold \$\${\textbackslash}mathcal \{M\}\$\$, a result which is of significant interest in topological manifold learning.},
	pages = {651--686},
	number = {3},
	journaltitle = {Probability Theory and Related Fields},
	shortjournal = {Probab. Theory Relat. Fields},
	author = {Bobrowski, Omer and Mukherjee, Sayan},
	urldate = {2026-03-23},
	date = {2015-04-01},
	langid = {english},
	keywords = {60F15, 60G55, Point process, Primary 60D05, Random Betti numbers, Random complexes, Secondary 55U10, Stochastic topology},
}

